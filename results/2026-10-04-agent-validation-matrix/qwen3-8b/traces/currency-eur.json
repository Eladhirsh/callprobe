{
  "id": "currency-eur",
  "tools": [
    {
      "name": "issue_refund",
      "description": "Issue a refund. Amount is in dollars, currency is explicit.",
      "parameters": {
        "type": "object",
        "properties": {
          "order_id": {
            "type": "string"
          },
          "amount": {
            "type": "number"
          },
          "currency": {
            "type": "string",
            "enum": [
              "USD",
              "EUR"
            ]
          }
        },
        "required": [
          "order_id",
          "amount",
          "currency"
        ],
        "additionalProperties": false
      },
      "side_effect": true
    },
    {
      "name": "send_email",
      "description": "Send a receipt email to an address.",
      "parameters": {
        "type": "object",
        "properties": {
          "to": {
            "type": "string"
          },
          "order_id": {
            "type": "string"
          }
        },
        "required": [
          "to",
          "order_id"
        ],
        "additionalProperties": false
      },
      "side_effect": true
    }
  ],
  "events": [
    {
      "type": "message",
      "role": "system",
      "content": "Use the available tools to carry out the request. Call one tool at a time. Use tool results to decide what to do next. Give a final response that accurately describes completed actions and failures."
    },
    {
      "type": "message",
      "role": "user",
      "content": "Refund order R-42 for 40 EUR. Do not email."
    },
    {
      "type": "tool_call",
      "id": "turn-0-call-0",
      "tool": "issue_refund",
      "args": {
        "amount": 40,
        "currency": "EUR",
        "order_id": "R-42"
      },
      "status": "ok",
      "result": {
        "refunded": true
      }
    },
    {
      "type": "message",
      "role": "assistant",
      "content": "The refund for order R-42 (40 EUR) has been successfully processed. No email was sent as requested."
    }
  ]
}
