+def _mapped_claims(raw: str, trace: Trace, index: int) -> list[Claim]:
+    """Validate the whole completed-tool list before filtering or attaching identity."""
+    fence = re.search(r"```(?:json)?\s*(.*?)```", raw, re.DOTALL)
+    text = fence.group(1) if fence else raw.strip()
+    try:
+        payload = loads(text)
+    except ValueError:
+        raise ClaimFormatError("invalid_action_map") from None
+    if not isinstance(payload, dict) or set(payload) != {"completed_tools"}:
+        raise ClaimFormatError("invalid_action_map")
+    tools = payload["completed_tools"]
+    if not isinstance(tools, list) or len(tools) > 100:
+        raise ClaimFormatError("invalid_action_map")
+    for tool in tools:
+        if tool is not None and (not isinstance(tool, str) or tool not in trace.tools):
+            raise ClaimFormatError("invalid_action_map")
+    target = next(m.content for m in trace.assistant_messages() if m.index == index)
+    return [
+        Claim(text=target, tool=tool, args={}, message_index=index)
+        for tool in dict.fromkeys(tools)
+        if tool is None or trace.is_side_effect(tool)
+    ]
+
