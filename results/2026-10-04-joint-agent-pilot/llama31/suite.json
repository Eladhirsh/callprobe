{
  "version": 1,
  "name": "refund-and-receipt-pilot",
  "cases": [
    {
      "id": "refund-and-receipt",
      "prompt": "Refund order R-42 for 40 USD, then email its receipt to dana@example.invalid. Do not retry failed operations.",
      "tools": [
        {
          "name": "issue_refund",
          "description": "Issue a refund. Amount is in dollars, currency is explicit.",
          "parameters": {
            "type": "object",
            "properties": {
              "order_id": {
                "type": "string"
              },
              "amount": {
                "type": "number"
              },
              "currency": {
                "type": "string",
                "enum": [
                  "USD",
                  "EUR"
                ]
              }
            },
            "required": [
              "order_id",
              "amount",
              "currency"
            ],
            "additionalProperties": false
          },
          "side_effect": true,
          "outcomes": [
            {
              "status": "ok",
              "result": {
                "refunded": true
              }
            }
          ]
        },
        {
          "name": "send_email",
          "description": "Send a receipt email to an address.",
          "parameters": {
            "type": "object",
            "properties": {
              "to": {
                "type": "string"
              },
              "order_id": {
                "type": "string"
              }
            },
            "required": [
              "to",
              "order_id"
            ],
            "additionalProperties": false
          },
          "side_effect": true,
          "outcomes": [
            {
              "status": "ok",
              "result": {
                "sent": true
              }
            }
          ]
        }
      ],
      "expected": [
        {
          "type": "call",
          "tool": "issue_refund",
          "args": {
            "order_id": "R-42",
            "amount": 40,
            "currency": "USD"
          }
        },
        {
          "type": "call",
          "tool": "send_email",
          "args": {
            "to": "dana@example.invalid",
            "order_id": "R-42"
          }
        },
        {
          "type": "no_call",
          "tool": null,
          "args": {}
        }
      ]
    },
